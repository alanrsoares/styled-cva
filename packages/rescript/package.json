  "files": [
    "rescript.json",
    "src/**/*.res"
  ],
  "dependencies": {
    "@styled-cva/react": "workspace:*"
  },
  "peerDependencies": {
    "@rescript/react": "^0.15.0",
    "rescript": "^12.0.0-alpha.9"
  },
  "devDependencies": {
    "@rescript/react": "^0.15.0",
    "rescript": "^12.0.0-alpha.9"
  }
