{
  "name": "@styled-cva/core",
  "description": "Shared utilities and CVA for styled-cva (React, Solid, etc.)",
  "version": "0.8.1",
  "publishConfig": {
    "access": "public"
  },
  "license": "Unlicense",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./formatting": {
      "types": "./dist/formatting/index.d.ts",
      "import": "./dist/formatting/index.mjs",
      "require": "./dist/formatting/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "bun test",
    "compile": "tsc --noEmit"
  },
  "dependencies": {
    "cn": "^0.5.2"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "typescript": ">=5.7.0"
  }
}
