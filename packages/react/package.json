{
  "name": "@styled-cva/react",
  "description": "A typesafe, class-variance-authority-based, styled-components-like library for authoring React components",
  "version": "0.8.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "Unlicense",
  "keywords": [
    "styled-components",
    "class-variance-authority",
    "react",
    "tailwindcss",
    "variants"
  ],
  "scripts": {
    "build": "bun compile && bun bundle",
    "compile": "tsc -p tsconfig.build.json --noEmit",
    "bundle": "NODE_OPTIONS=\"--max-old-space-size=4096\" tsup",
    "test": "vitest --run src",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "postversion": "bun run build",
    "format": "prettier --write ."
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@tsconfig/strictest": "^2.0.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-expect": "^1.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "typescript": ">=5.7.0"
  },
  "dependencies": {
    "@styled-cva/core": "^0.8.0"
  }
}
