// @styled-cva/biome-plugin: prefer-size-class
//
// Flag inline `tw.tag` / `tw(...)` tagged templates that have identical width
// and height classes (e.g. `w-4 h-4`, `h-4 w-4`, or `md:w-8 md:h-8`) and safely
// rewrite them to `size-n` (e.g. `size-4`, `md:size-8`).

engine biome(1.0)
language js

or {
  JsTemplateExpression(tag = `tw.$x`, elements = [$chunk]) as $t,
  JsTemplateExpression(tag = `tw($_)`, elements = [$chunk]) as $t
} where {
  $chunk <: JsTemplateChunkElement(),
  or {
    // Both with matching modifiers (e.g. md:w-4 md:h-4)
    $chunk <: r"^([a-z0-9_:\\[\\]\\-]+:)w-([^ ]+) ([a-z0-9_:\\[\\]\\-]+:)h-([^ ]+)$"($w_mod, $w, $h_mod, $h) where {
      $w_mod == $h_mod,
      $w == $h,
      $size_name = `size-$w`,
      $size_cls = `$w_mod$size_name`,
      $chunk => `$size_cls`
    },
    $chunk <: r"^(.* )([a-z0-9_:\\[\\]\\-]+:)w-([^ ]+) ([a-z0-9_:\\[\\]\\-]+:)h-([^ ]+)$"($prefix, $w_mod, $w, $h_mod, $h) where {
      $w_mod == $h_mod,
      $w == $h,
      $size_name = `size-$w`,
      $size_cls = `$w_mod$size_name`,
      $chunk => `$prefix$size_cls`
    },
    $chunk <: r"^([a-z0-9_:\\[\\]\\-]+:)w-([^ ]+) ([a-z0-9_:\\[\\]\\-]+:)h-([^ ]+)( .*)$"($w_mod, $w, $h_mod, $h, $suffix) where {
      $w_mod == $h_mod,
      $w == $h,
      $size_name = `size-$w`,
      $size_cls = `$w_mod$size_name`,
      $chunk => `$size_cls$suffix`
    },
    $chunk <: r"^(.* )([a-z0-9_:\\[\\]\\-]+:)w-([^ ]+) ([a-z0-9_:\\[\\]\\-]+:)h-([^ ]+)( .*)$"($prefix, $w_mod, $w, $h_mod, $h, $suffix) where {
      $w_mod == $h_mod,
      $w == $h,
      $size_name = `size-$w`,
      $size_cls = `$w_mod$size_name`,
      $chunk => `$prefix$size_cls$suffix`
    },
    $chunk <: r"^([a-z0-9_:\\[\\]\\-]+:)h-([^ ]+) ([a-z0-9_:\\[\\]\\-]+:)w-([^ ]+)$"($h_mod, $h, $w_mod, $w) where {
      $w_mod == $h_mod,
      $w == $h,
      $size_name = `size-$w`,
      $size_cls = `$w_mod$size_name`,
      $chunk => `$size_cls`
    },
    $chunk <: r"^(.* )([a-z0-9_:\\[\\]\\-]+:)h-([^ ]+) ([a-z0-9_:\\[\\]\\-]+:)w-([^ ]+)$"($prefix, $h_mod, $h, $w_mod, $w) where {
      $w_mod == $h_mod,
      $w == $h,
      $size_name = `size-$w`,
      $size_cls = `$w_mod$size_name`,
      $chunk => `$prefix$size_cls`
    },
    $chunk <: r"^([a-z0-9_:\\[\\]\\-]+:)h-([^ ]+) ([a-z0-9_:\\[\\]\\-]+:)w-([^ ]+)( .*)$"($h_mod, $h, $w_mod, $w, $suffix) where {
      $w_mod == $h_mod,
      $w == $h,
      $size_name = `size-$w`,
      $size_cls = `$w_mod$size_name`,
      $chunk => `$size_cls$suffix`
    },
    $chunk <: r"^(.* )([a-z0-9_:\\[\\]\\-]+:)h-([^ ]+) ([a-z0-9_:\\[\\]\\-]+:)w-([^ ]+)( .*)$"($prefix, $h_mod, $h, $w_mod, $w, $suffix) where {
      $w_mod == $h_mod,
      $w == $h,
      $size_name = `size-$w`,
      $size_cls = `$w_mod$size_name`,
      $chunk => `$prefix$size_cls$suffix`
    },
    // Bare classes (no modifier, e.g. w-4 h-4)
    $chunk <: r"^w-([^ ]+) h-([^ ]+)$"($w, $h) where {
      $w == $h,
      $size_cls = `size-$w`,
      $chunk => `$size_cls`
    },
    $chunk <: r"^(.* )w-([^ ]+) h-([^ ]+)$"($prefix, $w, $h) where {
      $w == $h,
      $size_cls = `size-$w`,
      $chunk => `$prefix$size_cls`
    },
    $chunk <: r"^w-([^ ]+) h-([^ ]+)( .*)$"($w, $h, $suffix) where {
      $w == $h,
      $size_cls = `size-$w`,
      $chunk => `$size_cls$suffix`
    },
    $chunk <: r"^(.* )w-([^ ]+) h-([^ ]+)( .*)$"($prefix, $w, $h, $suffix) where {
      $w == $h,
      $size_cls = `size-$w`,
      $chunk => `$prefix$size_cls$suffix`
    },
    $chunk <: r"^h-([^ ]+) w-([^ ]+)$"($h, $w) where {
      $w == $h,
      $size_cls = `size-$w`,
      $chunk => `$size_cls`
    },
    $chunk <: r"^(.* )h-([^ ]+) w-([^ ]+)$"($prefix, $h, $w) where {
      $w == $h,
      $size_cls = `size-$w`,
      $chunk => `$prefix$size_cls`
    },
    $chunk <: r"^h-([^ ]+) w-([^ ]+)( .*)$"($h, $w, $suffix) where {
      $w == $h,
      $size_cls = `size-$w`,
      $chunk => `$size_cls$suffix`
    },
    $chunk <: r"^(.* )h-([^ ]+) w-([^ ]+)( .*)$"($prefix, $h, $w, $suffix) where {
      $w == $h,
      $size_cls = `size-$w`,
      $chunk => `$prefix$size_cls$suffix`
    }
  },
  register_diagnostic(
    span = $t,
    message = "Use size-n instead of identical width and height classes.",
    severity = "warn",
    fix_kind = "safe"
  )
}
