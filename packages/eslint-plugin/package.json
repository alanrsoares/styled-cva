{
  "name": "@styled-cva/eslint-plugin",
  "version": "0.6.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "license": "Unlicense",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "bun test",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write ."
  },
  "peerDependencies": {
    "eslint": "^9 || ^10",
    "typescript": "^5 || ^6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@eslint/js": "^10.0.1",
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.10",
    "@types/estree-jsx": "^1.0.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
