// @styled-cva/biome-plugin: normalize-tw-classes
//
// Flag inline `tw.tag`/`tw(Component)` tagged templates whose class string has
// a run of horizontal whitespace, leading horizontal whitespace, or trailing
// horizontal whitespace, and rewrite it to single-spaced, trimmed classes.
//
// The fix collapses one run per pass; Biome re-applies safe plugin fixes until
// no rule rewrites, so `biome check --write` converges on any input length.
//
// Multi-line templates are left alone: every arm is anchored and `.` does not
// match a newline, so a wrapped template (see multiline-long-tw) never matches.

engine biome(1.0)
language js

// Resolve the local styled-cva binding: an aliased default import from any
// `@styled-cva/*` adapter, else the conventional bare `tw` — but only when the
// file does not import `tw` from somewhere else.
pattern styled_cva_binding($sc) {
  or {
    contains `import $sc from $src` where { $src <: r"\"@styled-cva/[a-z]+\"" },
    and {
      not contains `import tw from $other` where {
        $other <: not r"\"@styled-cva/[a-z]+\""
      },
      $sc = `tw`
    }
  }
}

// Static, single-chunk `tw.tag\`…\`` / `tw(Component)\`…\`` templates.
pattern tw_template($sc, $chunk) {
  or {
    JsTemplateExpression(tag = `$sc.$_`, elements = [$chunk]),
    JsTemplateExpression(tag = `$sc($_)`, elements = [$chunk])
  } where { $chunk <: JsTemplateChunkElement() }
}

file($body) where {
  $body <: styled_cva_binding($sc),
  $body <: contains bubble($sc) tw_template($sc, $chunk) as $t where {
    or {
      $chunk <: r"(.*?)[ \t][ \t]+(.*)"($head, $rest) where {
        $chunk => `$head $rest`
      },
      $chunk <: r"[ \t]+(.*)"($rest) where { $chunk => `$rest` },
      $chunk <: r"(.*?)[ \t]+"($head) where { $chunk => `$head` }
    },
    register_diagnostic(
      span = $t,
      message = "Tailwind class string has irregular whitespace.",
      severity = "warn",
      fix_kind = "safe"
    )
  }
}
