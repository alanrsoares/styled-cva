{
  "name": "@styled-cva/rescript",
  "description": "ReScript v12 bindings for @styled-cva/react",
  "version": "0.7.1",
  "publishConfig": {
    "access": "public"
  },
  "license": "Unlicense",
  "keywords": [
    "styled-components",
    "class-variance-authority",
    "rescript",
    "react",
    "tailwindcss",
    "variants"
  ],
  "scripts": {
    "build": "bun run scripts/generate.ts && rescript build",
