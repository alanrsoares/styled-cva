{
  "name": "@styled-cva/solid",
  "description": "A typesafe, class-variance-authority-based, styled-components-like library for authoring SolidJS components",
  "version": "0.7.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "Unlicense",
  "keywords": [
    "styled-components",
    "class-variance-authority",
    "solid",
    "solidjs",
    "tailwindcss",
    "variants"
  ],
  "scripts": {
    "build": "bun compile && bun bundle",
    "compile": "tsc -p tsconfig.build.json --noEmit",
    "bundle": "NODE_OPTIONS=\"--max-old-space-size=4096\" tsup",
    "test": "vitest --run src",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "postversion": "bun run build",
    "format": "prettier --write ."
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.4.4",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^10.14.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "solid-js": "^1.9.18",
    "ts-expect": "^1.3.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "solid-js": ">=1.8.0",
    "typescript": ">=5.7.0"
  },
  "dependencies": {
    "@styled-cva/core": "^0.8.0"
  }
}
